# misskey settings
# MISSKEY_URL=https://example.tld/

# db settings
POSTGRES_PASSWORD=example-misskey-pass
# DATABASE_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_USER=example-misskey-user
# DATABASE_USER=${POSTGRES_USER}
POSTGRES_DB=misskey
# DATABASE_DB=${POSTGRES_DB}
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"

# Optional Zalip Kodik importer configuration. API credentials stay server-side.
# Administrator settings override these environment defaults; never commit real keys.
# ZALIP_KODIK_API_TOKEN=
# ZALIP_KODIK_API_ORIGIN=https://kodik-api.com
# Optional exact HTTPS origin for an approved player mirror (no path or query).
# ZALIP_KODIK_PLAYER_ORIGIN=
# Comma-separated exact iframe hosts; defaults to kodikplayer.com when empty.
# ZALIP_KODIK_IFRAME_HOSTS=kodikplayer.com
